{
  "name": "alpenrenderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders the Alps in 3D from public elevation data, PeakVisor-style.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:shaders": "node tools/check_wgsl.mjs && node tools/check_math.mjs && node tools/check_clipmap.mjs",
    "check": "tsc --noEmit && npm run check:shaders",
    "cache:tiles": "node tools/cache_tiles.mjs",
    "shot": "node tools/shot.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.19.0",
    "geomagnetism": "^0.2.0",
    "pmtiles": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wgsl_reflect": "^1.5.0"
  }
}
