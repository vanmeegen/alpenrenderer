{
  "name": "alpenrenderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders the Alps in 3D from public elevation data, PeakVisor-style.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:data": "playwright test --config tests/data/playwright.config.ts",
    "test": "bun run test:unit && bun run test:e2e",
    "check": "tsc --noEmit && bun test tests/unit",
    "cache:tiles": "node tools/cache_tiles.mjs",
    "serve": "node tools/serve.mjs",
    "shot": "node tools/shot.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.19.0",
    "geomagnetism": "^0.2.0",
    "leaflet": "^1.9.4",
    "pmtiles": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "playwright": "1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wgsl_reflect": "^1.5.0"
  }
}
